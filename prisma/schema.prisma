generator client {
  provider      = "prisma-client-js"
  // native = local macOS/Linux; linux-musl = Dokploy/Docker Alpine runner
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String
  company            String?
  phone              String?
  subject            String?
  message            String
  source             String    @default("contact")
  turnstileHostname  String?   @map("turnstile_hostname")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  readAt             DateTime? @map("read_at")

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([readAt])
  @@map("contacts")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email              String  @unique
  source             String  @default("homepage")
  turnstileHostname  String? @map("turnstile_hostname")
  userAgent          String? @map("user_agent")
  ipAddress          String? @map("ip_address")

  @@index([createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@map("newsletter_subscribers")
}

model QuoteRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String
  company            String
  phone              String?
  country            String?
  siteSize           String    @map("site_size")
  subscriptionTier  String    @map("subscription_tier")
  solutions          String[]  @default([])
  message            String?
  source             String    @default("request-quote")
  turnstileHostname  String?   @map("turnstile_hostname")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  readAt             DateTime? @map("read_at")

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([readAt])
  @@map("quote_requests")
}

enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum WorkArrangement {
  REMOTE
  ONSITE
  HYBRID
  FREELANCE
}

enum CandidateStage {
  APPLIED
  SCREENING
  ONLINE_INTERVIEW
  ONSITE_INTERVIEW
  ASSESSMENT
  SHORTLISTED
  PRE_HIRE
  OFFER
  HIRED
  REJECTED
}

/// HR-managed openings (existing `job_openings` table). Read-only from this app.
model JobOpening {
  id                   String            @id @default(cuid())
  title                String
  departmentId         String?
  status               JobOpeningStatus  @default(DRAFT)
  description          String?
  responsibilities     String?
  requirements         String?
  location             String?
  employmentType       EmploymentType
  workArrangement      WorkArrangement?
  publicSlug           String?
  applicationDeadline  DateTime?
  openedAt             DateTime?
  closedAt             DateTime?
  publishedAt          DateTime?
  hiringManagerUserId  String?
  createdByUserId      String?
  deletedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  department HrDepartment? @relation(fields: [departmentId], references: [id])
  candidates JobCandidate[]

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@map("job_openings")
}

model HrDepartment {
  id             String    @id @default(cuid())
  name           String
  code           String?
  description    String?
  officeLocation String?
  countryCode    String?
  parentId       String?
  managerUserId  String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  openings JobOpening[]

  @@map("hr_departments")
}

/// HR candidates table. Marketing site writes only application-necessary fields.
model JobCandidate {
  id                   String         @id @default(cuid())
  jobOpeningId         String
  firstName            String
  lastName             String
  email                String
  phone                String?
  coverLetter          String?
  resumeStorageKey     String?
  resumeFileName       String?
  resumeContentType    String?
  stage                CandidateStage @default(APPLIED)
  source               String?
  applicationIpHash    String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])

  @@index([jobOpeningId, stage])
  @@index([email])
  @@index([stage, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("job_candidates")
}

/// App users (product + blog interactions). Linked via supabaseId.
model User {
  id         String   @id
  supabaseId String?  @unique
  email      String
  firstName  String?
  lastName   String?
  avatarUrl  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authoredPosts BlogPost[]    @relation("BlogPostAuthor")
  reviewedPosts BlogPost[]    @relation("BlogPostReviewer")
  comments      BlogComment[]
  likes         BlogPostLike[]

  @@map("users")
}

enum BlogPostStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum BlogCommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

/// CMS blog posts (existing `blog_posts` table). Marketing site reads published posts.
model BlogPost {
  id                   String         @id
  slug                 String         @unique
  title                String
  excerpt              String?
  content              String
  coverImageUrl        String?
  coverImageAlt        String?
  categoryId           String?
  authorUserId         String?
  readingTimeMinutes   Int?
  status               BlogPostStatus
  submittedForReviewAt DateTime?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  rejectionReason      String?
  publishedAt          DateTime?
  deletedAt            DateTime?
  metaTitle            String?
  metaDescription      String?
  canonicalUrl         String?
  ogTitle              String?
  ogDescription        String?
  ogImageUrl           String?
  focusKeyword         String?
  seoKeywords          String[]
  robotsIndex          Boolean        @default(true)
  robotsFollow         Boolean        @default(true)
  structuredData       Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  category BlogCategory?  @relation(fields: [categoryId], references: [id])
  author   User?          @relation("BlogPostAuthor", fields: [authorUserId], references: [id])
  reviewer User?          @relation("BlogPostReviewer", fields: [reviewedByUserId], references: [id])
  tags     BlogPostTag[]
  comments BlogComment[]
  likes    BlogPostLike[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([deletedAt])
  @@index([categoryId])
  @@index([authorUserId])
  @@index([reviewedByUserId])
  @@index([focusKeyword])
  @@map("blog_posts")
}

model BlogCategory {
  id          String    @id
  slug        String    @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id])
  children BlogCategory[] @relation("BlogCategoryTree")
  posts    BlogPost[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("blog_categories")
}

model BlogTag {
  id        String    @id
  slug      String    @unique
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts BlogPostTag[]

  @@index([deletedAt])
  @@map("blog_tags")
}

model BlogPostTag {
  id        String   @id
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id])
  tag  BlogTag  @relation(fields: [tagId], references: [id])

  @@unique([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

model BlogComment {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  body      String
  status    BlogCommentStatus @default(VISIBLE)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  parent  BlogComment?  @relation("BlogCommentThread", fields: [parentId], references: [id])
  replies BlogComment[] @relation("BlogCommentThread")

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("blog_comments")
}

model BlogPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("blog_post_likes")
}

