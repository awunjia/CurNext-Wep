# Local development (http://localhost:3003)
# Dokploy production: https://curnext.app
# Also pass NEXT_PUBLIC_* as Dokploy Build Arguments (Dockerfile ARG).
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase Auth (blog likes/comments + shared project with product)
# Redirect URL allowlist must include:
#   http://localhost:3003/auth/callback
#   https://curnext.app/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres for Prisma
# From Supabase → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Cloudflare Turnstile
# Production: use your CurNext widget keys (hostnames: curnext.app).
# Local: prefer Cloudflare always-pass test keys in .env.local (any hostname):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# If you insist on real keys locally, add hostname "localhost" (no port) and
# optionally "127.0.0.1" in Turnstile Hostname Management - error 110200 means
# the browser hostname is not on that list.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP2GO (email delivery)
# Port 2525 or 587: set SMTP_SECURE=false (STARTTLS)
# Port 465: set SMTP_SECURE=true (implicit TLS)
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_DEFAULT=noreply@curnext.app
SMTP_FROM_NOREPLY=info@curnext.app
SALES_EMAIL=sales@curnext.app
CONTACT_EMAIL=info@curnext.app
DEV_EMAIL=dev@curnext.app
SECURITY_EMAIL=security@curnext.app
GDPR_EMAIL=gdpr@curnext.app
SUPPORT_EMAIL=support@curnext.app
# Knowledge Base AI (Groq free-tier models)
# Create a key at https://console.groq.com - without it the API returns corpus excerpts only
GROQ_API_KEY=
# Optional override (default: llama-3.1-8b-instant)
GROQ_MODEL=

# Cloudflare R2 (resume uploads)
R2_ACCOUNT_ID=
# Leave empty unless the bucket was created in an EU jurisdiction
R2_JURISDICTION=
R2_PUBLIC_URL=
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=curnext
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
